#!/usr/bin/env bash
# port-broadcast-launcher — one Linux terminal window, N tabs of port-broadcast-shell
#
# Opens ONE regular Terminal window (Ubuntu default: Ptyxis; desktop name "Terminal")
# with N tabs. Each tab runs port-broadcast-shell on a distinct listen port.
# Austen watches the window; agents attach with nc.
#
# Not Cursor's integrated terminal — and not a hard-wired gnome-terminal path.
# Prefer: ptyxis (system default / x-terminal-emulator on Ubuntu) → kgx → gnome-terminal.
#
# Safety (machine previously hard-crashed on reckless multi-spawn / GUI smoke):
#   - ONE terminal window with N tabs (never N windows)
#   - Hard cap on tab count
#   - Preflight: DISPLAY/dbus/terminal/script/nc/ports
#   - Any real GUI launch requires --confirm (use --dry-run first)
#   - --dry-run prints launch argv + port map only (agent-safe; no GUI)
#   - Tabs keep a trailing interactive shell after the hop exits (scrollback stays)
#
# Usage:
#   ./bin/port-broadcast-launcher --dry-run --smoke
#   ./bin/port-broadcast-launcher --smoke --confirm          # 1-tab GUI (Austen OK)
#   ./bin/port-broadcast-launcher --tabs 6 --confirm
#   ./bin/port-broadcast-launcher --tabs 3 --confirm --tab-cmd 2='npm run dev'
#   ./bin/port-broadcast-launcher --ports 4591,4600,4700 --confirm
#   ./bin/port-broadcast-launcher --config ./tabs.conf --confirm
#   ./bin/port-broadcast-launcher --dry-run --tabs 6 --confirm -- dssh logs backend

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SELF="${ROOT}/bin/port-broadcast-launcher"
SHELL_HELPER="${ROOT}/bin/port-broadcast-shell"
BIND="${PORT_BROADCAST_BIND:-127.0.0.1}"
BASE_PORT="${PORT_BROADCAST_BASE_PORT:-4591}"
TABS="${PORT_BROADCAST_TABS:-6}"
MAX_TABS="${PORT_BROADCAST_MAX_TABS:-16}"
CONFIRM=0
DRY_RUN=0
SMOKE=0
PORTS_EXPLICIT=0
TABS_EXPLICIT=0
CONFIG_FILE=""
DEFAULT_CMD=()
# Resolved terminal binary + kind (ptyxis|kgx|gnome-terminal)
TERM_BIN=""
TERM_KIND=""
# Per-tab command overrides keyed by 1-based index (sparse). Empty string = interactive.
declare -A TAB_CMD=()
declare -a PORT_LIST=()

usage() {
	cat <<'EOF'
Usage: port-broadcast-launcher [options] [-- command [args...]]

  Open ONE regular Linux Terminal window (Ptyxis / Ubuntu “Terminal” by default)
  with N tabs. Each tab runs bin/port-broadcast-shell on a distinct port.
  Empty tab command = interactive shell. After a tab command exits, the tab
  keeps an interactive bash inside the hop so the tab, scrollback, and TCP
  listen stay up.
  Not Cursor's integrated terminal.

Options:
  -n, --tabs N              Tab count (default: 6, or PORT_BROADCAST_TABS; max 16)
  -p, --base-port PORT      First listen port (default: 4591); ports = base..base+N-1
      --ports LIST          Comma-separated ports (sets tab count unless --tabs given)
  -b, --bind ADDR           Listen address (default: 127.0.0.1, or PORT_BROADCAST_BIND)
      --cmd CMD             Default command for every tab without --tab-cmd (shell -c)
      --tab-cmd INDEX=CMD   Per-tab command (1-based; repeatable). Empty CMD = interactive
  -c, --config FILE         Load tabs/ports/cmds from a config file (see README)
      --confirm, -y         Required for any real GUI launch (prevents accidental spawn)
      --smoke               1-tab short-lived smoke; implies --tabs 1
      --dry-run             Print terminal argv + port map; do not launch (agent-safe)
  -h, --help                Show this help

  -- command ...            Same as --cmd: default command for tabs without --tab-cmd

Config file (KEY=VALUE, # comments):
  tabs=3
  base-port=4591
  bind=127.0.0.1
  ports=4591,4600,4700
  cmd=echo default
  tab.1=
  tab.2=npm run dev

Agent attach (after launch):
  nc 127.0.0.1 4591
  …

Safe first steps:
  ./bin/port-broadcast-launcher --dry-run --smoke
  ./bin/port-broadcast-shell -p 4591 -- bash -c 'echo SMOKE_OK; sleep 2'
  # GUI smoke only with Austen OK:
  ./bin/port-broadcast-launcher --smoke --confirm
EOF
}

die() {
	echo "port-broadcast-launcher: $*" >&2
	exit 1
}

# Prefer Ubuntu’s default Terminal (Ptyxis), then kgx, then gnome-terminal.
resolve_terminal() {
	local cand resolved=""
	if [[ -n "${PORT_BROADCAST_TERMINAL:-}" ]]; then
		cand="${PORT_BROADCAST_TERMINAL}"
		command -v "$cand" >/dev/null 2>&1 || die "PORT_BROADCAST_TERMINAL not found: $cand"
		TERM_BIN="$(command -v "$cand")"
	else
		for cand in ptyxis kgx gnome-terminal; do
			if command -v "$cand" >/dev/null 2>&1; then
				TERM_BIN="$(command -v "$cand")"
				break
			fi
		done
		# Last resort: Debian/Ubuntu alternatives (often ptyxis on current Ubuntu)
		if [[ -z "$TERM_BIN" ]] && command -v x-terminal-emulator >/dev/null 2>&1; then
			TERM_BIN="$(command -v x-terminal-emulator)"
		fi
		[[ -n "$TERM_BIN" ]] || die "no terminal found (need ptyxis, kgx, or gnome-terminal)"
	fi
	resolved="$(basename "$(readlink -f "$TERM_BIN" 2>/dev/null || echo "$TERM_BIN")")"
	case "$resolved" in
		ptyxis|org.gnome.Ptyxis*)
			TERM_KIND=ptyxis
			;;
		kgx|gnome-console*)
			TERM_KIND=kgx
			;;
		gnome-terminal|gnome-terminal.real|gnome-terminal.wrapper)
			TERM_KIND=gnome-terminal
			;;
		*)
			# x-terminal-emulator → follow target name already; unknown wrapper → probe --help
			if "$TERM_BIN" --help 2>&1 | grep -q -- '--new-window'; then
				TERM_KIND=ptyxis
			elif "$TERM_BIN" --help 2>&1 | grep -q -- '--tab'; then
				TERM_KIND=gnome-terminal
			else
				die "unsupported terminal binary: $TERM_BIN (set PORT_BROADCAST_TERMINAL=ptyxis)"
			fi
			;;
	esac
}

# Internal worker: the terminal invokes a tiny runner that calls this.
# Avoids nested-quote hell (one executable path only).
#
# One-shot / restart tab commands are wrapped with a trailing interactive shell
# *inside* the hop (`cmd; exec bash`) so the tab, scrollback, and TCP listen
# stay up after the command finishes — previously those tabs vanished.
exec_tab() {
	local state_dir="" port="" bind="$BIND" index=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--state)
				state_dir="${2:?}"
				shift 2
				;;
			-p|--port)
				port="${2:?}"
				shift 2
				;;
			-b|--bind)
				bind="${2:?}"
				shift 2
				;;
			-i|--index)
				index="${2:?}"
				shift 2
				;;
			*)
				die "exec-tab: unknown arg: $1"
				;;
		esac
	done
	[[ -n "$state_dir" && -n "$port" ]] || die "exec-tab requires --state DIR -p PORT"
	local -a extra=()
	local cmd_file="$state_dir/cmd"
	if [[ -n "$index" && -f "$state_dir/cmd.$index" ]]; then
		cmd_file="$state_dir/cmd.$index"
	fi
	if [[ -f "$cmd_file" && -s "$cmd_file" ]]; then
		# shellcheck disable=SC1090
		source "$cmd_file"
		extra=("${PORT_BROADCAST_TAB_CMD[@]}")
	fi
	if ((${#extra[@]})); then
		local run_line
		run_line="$(printf '%q ' "${extra[@]}")"
		exec "$SHELL_HELPER" -b "$bind" -p "$port" -- bash -c \
			"${run_line}"$'\n'"printf 'port-broadcast: command finished (port %s); keeping hop open\\n' $(printf '%q' "$port") >&2"$'\n'"exec \"\${SHELL:-bash}\" -i"
	fi
	exec "$SHELL_HELPER" -b "$bind" -p "$port"
}

if [[ "${1:-}" == "--exec-tab" ]]; then
	shift
	exec_tab "$@"
fi

write_cmd_file() {
	local path="$1"
	shift
	if (($#)); then
		{
			printf 'PORT_BROADCAST_TAB_CMD=('
			printf ' %q' "$@"
			printf ' )\n'
		} >"$path"
	else
		: >"$path"
	fi
}

load_config() {
	local file="$1" line key val idx
	[[ -f "$file" ]] || die "config not found: $file"
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%%#*}"
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[[ -z "$line" ]] && continue
		[[ "$line" == *=* ]] || die "config: expected KEY=VALUE (got: $line)"
		key="${line%%=*}"
		val="${line#*=}"
		key="${key%"${key##*[![:space:]]}"}"
		case "$key" in
			tabs)
				TABS="$val"
				TABS_EXPLICIT=1
				;;
			base-port|base_port)
				BASE_PORT="$val"
				;;
			bind)
				BIND="$val"
				;;
			ports)
				parse_ports_list "$val"
				;;
			cmd)
				DEFAULT_CMD=(bash -c "$val")
				;;
			tab.*)
				idx="${key#tab.}"
				[[ "$idx" =~ ^[0-9]+$ ]] || die "config: bad tab key: $key"
				TAB_CMD["$idx"]=$val
				;;
			*)
				die "config: unknown key: $key"
				;;
		esac
	done <"$file"
}

parse_ports_list() {
	local raw="$1" p
	local -a cleaned=()
	PORTS_EXPLICIT=1
	PORT_LIST=()
	IFS=',' read -r -a PORT_LIST <<<"$raw"
	for p in "${PORT_LIST[@]}"; do
		p="${p#"${p%%[![:space:]]*}"}"
		p="${p%"${p##*[![:space:]]}"}"
		[[ "$p" =~ ^[0-9]+$ ]] || die "invalid port in --ports: $p"
		((p >= 1 && p <= 65535)) || die "port out of range: $p"
		cleaned+=("$p")
	done
	PORT_LIST=("${cleaned[@]}")
	((${#PORT_LIST[@]} >= 1)) || die "--ports needs at least one port"
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-n|--tabs)
			TABS="${2:?missing tab count}"
			TABS_EXPLICIT=1
			shift 2
			;;
		-p|--base-port)
			BASE_PORT="${2:?missing base port}"
			shift 2
			;;
		--ports)
			parse_ports_list "${2:?missing ports list}"
			shift 2
			;;
		-b|--bind)
			BIND="${2:?missing bind address}"
			shift 2
			;;
		--cmd)
			DEFAULT_CMD=(bash -c "${2:?missing command}")
			shift 2
			;;
		--tab-cmd)
			spec="${2:?missing INDEX=command}"
			idx="${spec%%=*}"
			rest="${spec#*=}"
			[[ "$spec" == *=* ]] || die "--tab-cmd needs INDEX=command (got: $spec)"
			[[ "$idx" =~ ^[0-9]+$ ]] || die "--tab-cmd index must be 1-based integer"
			TAB_CMD["$idx"]=$rest
			shift 2
			;;
		-c|--config)
			CONFIG_FILE="${2:?missing config path}"
			shift 2
			;;
		--confirm|-y)
			CONFIRM=1
			shift
			;;
		--smoke)
			SMOKE=1
			shift
			;;
		--dry-run)
			DRY_RUN=1
			shift
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			DEFAULT_CMD=("$@")
			break
			;;
		-*)
			die "unknown option: $1"
			;;
		*)
			die "unexpected argument: $1 (use -- before a command)"
			;;
	esac
done

if [[ -n "$CONFIG_FILE" ]]; then
	load_config "$CONFIG_FILE"
fi

if ((SMOKE)); then
	TABS=1
	TABS_EXPLICIT=1
	PORTS_EXPLICIT=0
	PORT_LIST=()
	if ((${#DEFAULT_CMD[@]} == 0)) && [[ -z "${TAB_CMD[1]+x}" ]]; then
		DEFAULT_CMD=(bash -c 'echo "port-broadcast smoke: tab1 ok"; tty; echo SMOKE_OK; sleep 8')
	fi
fi

if ((PORTS_EXPLICIT)); then
	if ((TABS_EXPLICIT)) && ((TABS != ${#PORT_LIST[@]})); then
		die "--tabs ${TABS} does not match --ports count ${#PORT_LIST[@]}"
	fi
	TABS="${#PORT_LIST[@]}"
fi

if ! [[ "$TABS" =~ ^[0-9]+$ ]] || ((TABS < 1 || TABS > MAX_TABS)); then
	die "tabs must be 1..${MAX_TABS} (got: $TABS)"
fi

if ! ((PORTS_EXPLICIT)); then
	if ! [[ "$BASE_PORT" =~ ^[0-9]+$ ]] || ((BASE_PORT < 1 || BASE_PORT > 65535)); then
		die "invalid base port: $BASE_PORT"
	fi
	PORT_LIST=()
	local_i=0
	for ((local_i = 0; local_i < TABS; local_i++)); do
		PORT_LIST+=("$((BASE_PORT + local_i))")
	done
fi

((${#PORT_LIST[@]} == TABS)) || die "internal: port list length ${#PORT_LIST[@]} != tabs $TABS"

for port in "${PORT_LIST[@]}"; do
	[[ "$port" =~ ^[0-9]+$ ]] || die "invalid port: $port"
	((port >= 1 && port <= 65535)) || die "port out of range: $port"
done

LAST_PORT="${PORT_LIST[$((TABS - 1))]}"
FIRST_PORT="${PORT_LIST[0]}"

for idx in "${!TAB_CMD[@]}"; do
	((idx >= 1 && idx <= TABS)) || die "--tab-cmd index $idx out of range 1..$TABS"
done

# Real GUI launch always needs --confirm (incl. 1-tab / --smoke) after prior crashes.
if ((DRY_RUN == 0 && CONFIRM == 0)); then
	die "GUI launch requires --confirm (try --dry-run first; agents: hop-smoke with bin/port-broadcast-shell)"
fi

[[ -x "$SHELL_HELPER" ]] || die "missing executable: $SHELL_HELPER"
[[ -x "$SELF" ]] || die "launcher not executable: $SELF"

resolve_terminal

if ((DRY_RUN == 0)); then
	[[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || die "no DISPLAY/WAYLAND_DISPLAY (GUI session required)"
	command -v script >/dev/null 2>&1 || die "script(1) required"
	command -v nc >/dev/null 2>&1 || die "nc required"
	if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]]; then
		export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
	fi
	[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || die "DBUS_SESSION_BUS_ADDRESS unset (no session bus)"
	if ! timeout 3 gdbus introspect --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus >/dev/null 2>&1; then
		die "session dbus not reachable (refuse GUI launch)"
	fi
fi

echo "port-broadcast-launcher: terminal=${TERM_KIND} (${TERM_BIN}) tabs=${TABS} bind=${BIND} ports=${FIRST_PORT}…${LAST_PORT}" >&2
for ((i = 0; i < TABS; i++)); do
	port="${PORT_LIST[$i]}"
	idx=$((i + 1))
	cmd_note="interactive"
	if [[ -n "${TAB_CMD[$idx]+x}" ]]; then
		if [[ -z "${TAB_CMD[$idx]}" ]]; then
			cmd_note="interactive"
		else
			cmd_note="cmd: ${TAB_CMD[$idx]}"
		fi
	elif ((${#DEFAULT_CMD[@]})); then
		cmd_note="cmd: ${DEFAULT_CMD[*]}"
	fi
	echo "  tab ${idx}: nc ${BIND} ${port}  (${cmd_note})" >&2
	if ((DRY_RUN == 0)); then
		if ss -ltn "( sport = :$port )" 2>/dev/null | grep -q ":${port} "; then
			die "port ${port} already in use"
		fi
	fi
done

STATE_DIR="$(mktemp -d /tmp/port-broadcast-launcher.XXXXXX)"
write_cmd_file "$STATE_DIR/cmd" "${DEFAULT_CMD[@]+"${DEFAULT_CMD[@]}"}"
for ((i = 1; i <= TABS; i++)); do
	if [[ -n "${TAB_CMD[$i]+x}" ]]; then
		if [[ -z "${TAB_CMD[$i]}" ]]; then
			write_cmd_file "$STATE_DIR/cmd.$i"
		else
			write_cmd_file "$STATE_DIR/cmd.$i" bash -c "${TAB_CMD[$i]}"
		fi
	fi
done

declare -a RUNNERS=()
declare -a TITLES=()
for ((i = 0; i < TABS; i++)); do
	port="${PORT_LIST[$i]}"
	idx=$((i + 1))
	title="pb:${port}"
	runner="$STATE_DIR/run-${port}"
	cat >"$runner" <<EOF
#!/usr/bin/env bash
exec $(printf '%q' "$SELF") --exec-tab --state $(printf '%q' "$STATE_DIR") -b $(printf '%q' "$BIND") -p $(printf '%q' "$port") -i $(printf '%q' "$idx")
EOF
	chmod +x "$runner"
	RUNNERS+=("$runner")
	TITLES+=("$title")
done

# Build per-emulator launch argv lists.
#
# Ptyxis/kgx cannot combine --new-window and --tab in one argv. External
# `ptyxis --tab` lands on the *active* window, which races with other Terminal
# windows and often leaves only tab 1 visible in the new window. Fix: open the
# window with a bootstrap that runs *inside* that window (so it is active),
# asks Ptyxis/kgx for sibling --tab runners, then execs tab 1's hop.
declare -a LAUNCH_STEPS=()
case "$TERM_KIND" in
	ptyxis|kgx)
		BOOT="$STATE_DIR/bootstrap"
		{
			printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
			printf 'TERM_BIN=%q\n' "$TERM_BIN"
			printf 'ROOT=%q\n' "$ROOT"
			printf 'echo "port-broadcast-launcher: opening %s sibling tab(s) from active window…" >&2\n' "$((TABS - 1))"
			for ((i = 1; i < TABS; i++)); do
				if [[ "$TERM_KIND" == ptyxis ]]; then
					printf '%s\n' \
						"\"\$TERM_BIN\" --tab -T $(printf '%q' "${TITLES[$i]}") -d \"\$ROOT\" -x $(printf '%q' "${RUNNERS[$i]}")" \
						'sleep 0.15'
				else
					printf '%s\n' \
						"\"\$TERM_BIN\" --tab --title=$(printf '%q' "${TITLES[$i]}") --working-directory=\"\$ROOT\" -- $(printf '%q' "${RUNNERS[$i]}")" \
						'sleep 0.15'
				fi
			done
			printf 'exec %q\n' "${RUNNERS[0]}"
		} >"$BOOT"
		chmod +x "$BOOT"
		if [[ "$TERM_KIND" == ptyxis ]]; then
			LAUNCH_STEPS+=("0"$'\t'"$TERM_BIN"$'\t'"--new-window"$'\t'"-T"$'\t'"${TITLES[0]}"$'\t'"-d"$'\t'"$ROOT"$'\t'"-x"$'\t'"$BOOT")
		else
			LAUNCH_STEPS+=("0"$'\t'"$TERM_BIN"$'\t'"--new-window"$'\t'"--title=${TITLES[0]}"$'\t'"--working-directory=$ROOT"$'\t'"--"$'\t'"$BOOT")
		fi
		;;
	gnome-terminal)
		# Single process: --command per tab (a bare -- would swallow later --tab args).
		declare -a gt_args=("$TERM_BIN" --geometry=100x28 --role=port-broadcast-launcher)
		for ((i = 0; i < TABS; i++)); do
			if ((i == 0)); then
				gt_args+=(--window --title="${TITLES[$i]}" --working-directory="$ROOT" --command "${RUNNERS[$i]}")
			else
				gt_args+=(--tab --title="${TITLES[$i]}" --working-directory="$ROOT" --command "${RUNNERS[$i]}")
			fi
		done
		LAUNCH_STEPS+=("all"$'\t'"$(printf '%s\t' "${gt_args[@]}")")
		;;
	*)
		die "internal: unhandled TERM_KIND=$TERM_KIND"
		;;
esac

if ((DRY_RUN)); then
	echo "dry-run launch (${#LAUNCH_STEPS[@]} step(s), kind=${TERM_KIND}):" >&2
	for step in "${LAUNCH_STEPS[@]}"; do
		# shellcheck disable=SC2206
		IFS=$'\t' read -r -a parts <<<"$step"
		printf '  ' >&2
		# skip index field
		printf '%q ' "${parts[@]:1}" >&2
		echo >&2
	done
	if [[ -f "${BOOT:-}" ]]; then
		echo "dry-run bootstrap ($BOOT):" >&2
		sed 's/^/  /' "$BOOT" >&2
	fi
	rm -rf "$STATE_DIR"
	exit 0
fi

echo "port-broadcast-launcher: launching one ${TERM_KIND} window (${TABS} tab(s))…" >&2
run_step() {
	local step="$1"
	local -a parts=()
	IFS=$'\t' read -r -a parts <<<"$step"
	# parts[0]=index; remainder=argv
	"${parts[@]:1}"
}

case "$TERM_KIND" in
	ptyxis|kgx)
		# Bootstrap (inside the new window) opens sibling tabs, then becomes tab 1.
		run_step "${LAUNCH_STEPS[0]}" &
		;;
	gnome-terminal)
		run_step "${LAUNCH_STEPS[0]}"
		;;
esac
# Leave STATE_DIR for runners; cleaned up when window closes / reboot.
exit 0
